text  x=97 y=33.5 anchor=r w=36 size=4 font=smooth weight=regular color=#C7CBD8 text="{cpu_temp}   {cpu_power}   {cpu_freq}"
rect  x=45 y=47.5 w=0.5 h=17 color=#F28BA8 opacity=100
text  x=47 y=46 anchor=tl size=3 font=smooth weight=medium color=#F28BA8 text="GRAPHICS"
