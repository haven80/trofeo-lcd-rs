ring  x=21 y=50 anchor=c w=17.2 h=71 value=gpu color=#F28BA8 color2=#FFD3E0 flow=7 back=#1C2030 thick=4 hot=90 hot_color=#FF6B6B
ring  x=21 y=50 anchor=c w=12.4 h=51 value=ram text="{time_short}" font=smooth weight=light color=#7CD6E0 color2=#D3F6FA flow=8 back=#1C2030 thick=5.5 hot=90 hot_color=#FF6B6B
text  x=45 y=9 anchor=tl size=3 font=smooth weight=medium color=#8F95A8 text="{date}"
text  x=97 y=9 anchor=r w=26 size=4 font=smooth weight=light color=#C7CBD8 text="{weather_temp}  {weather_city}"
