# cluster — a car instrument cluster: three big dials, the clock and the song on the side.
rect  x=0 y=0 w=100 h=100 color=#101315 opacity=72
rect  x=1 y=4 w=21 h=92 color=#171B1E
text  x=2.5 y=8 size=2 font=smooth weight=medium color=#8C9490 text="{date}"
text  x=2.3 y=26 anchor=l size=10 font=smooth weight=light color=#F3F5F4 text="{time_short}"
rect  x=2.5 y=44 w=18 h=0.25 color=#2E3336
text  x=2.5 y=54 anchor=l size=8 font=smooth weight=light color=#F3F5F4 text="{weather_temp}"
text  x=2.5 y=64 size=3 font=smooth weight=regular color=#8C9490 text="{weather_city}"
rect  x=2.5 y=74 w=18 h=0.25 color=#2E3336
text  x=2.5 y=80 size=2 font=smooth weight=medium color=#A9CDB8 text="NOW PLAYING"
text  x=2.5 y=86 w=18 size=3 font=smooth weight=regular color=#F3F5F4 text="{song}"
ring  x=36 y=50 anchor=c w=21 h=88 value=cpu_temp text="{cpu_temp}" font=smooth weight=light color=#A9CDB8 back=#2E3336 thick=7 hot=85 hot_color=#E58A7B
text  x=36 y=27 anchor=c size=3 font=smooth weight=medium color=#A9CDB8 text="CPU"
text  x=36 y=73 anchor=c w=14 size=3 font=smooth weight=regular color=#8C9490 text="{cpu}   {cpu_power}"
ring  x=59 y=50 anchor=c w=21 h=88 value=gpu_temp text="{gpu_temp}" font=smooth weight=light color=#A9CDB8 back=#2E3336 thick=7 hot=85 hot_color=#E58A7B
text  x=59 y=27 anchor=c size=3 font=smooth weight=medium color=#A9CDB8 text="GPU"
text  x=59 y=73 anchor=c w=14 size=3 font=smooth weight=regular color=#8C9490 text="{gpu}   {gpu_power}"
ring  x=82 y=50 anchor=c w=21 h=88 value=ram text="{ram}" font=smooth weight=light color=#A9CDB8 back=#2E3336 thick=7 hot=85 hot_color=#E58A7B
text  x=82 y=27 anchor=c size=3 font=smooth weight=medium color=#A9CDB8 text="MEMORY"
text  x=82 y=73 anchor=c w=14 size=3 font=smooth weight=regular color=#8C9490 text="{ram_used} / {ram_total}"
