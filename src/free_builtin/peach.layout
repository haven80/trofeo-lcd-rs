# peach
rect  x=0 y=0 w=100 h=100 color=#FFF4EC opacity=97
text  x=3.5 y=9 anchor=tl size=3 font=smooth weight=medium color=#8A7A74 text="{date}"
text  x=3 y=38 anchor=l size=19 font=smooth weight=light color=#2B2B33 text="{time_short}"
text  x=3.5 y=66 anchor=l size=8 font=smooth weight=light color=#2B2B33 text="{weather_temp}"
text  x=3.5 y=76 anchor=tl size=3 font=smooth weight=regular color=#8A7A74 text="{weather_city}"
text  x=3.5 y=86 anchor=tl w=30 size=3 font=smooth weight=medium color=#2B2B33 text="{song}"
ring  x=48 y=44 anchor=c w=16.4 h=68 value=cpu text="{cpu}" font=smooth weight=light color=#FF7A59 color2=#FFB199 back=#F0DFD2 thick=7 hot=92 hot_color=#E5484D
text  x=48 y=82 anchor=c size=3 font=smooth weight=medium color=#FF7A59 text="PROCESSOR"
text  x=48 y=91 anchor=c w=19 size=3 font=smooth weight=regular color=#6B5E58 text="{cpu_temp}  ·  {cpu_power}"
ring  x=69 y=44 anchor=c w=16.4 h=68 value=gpu text="{gpu}" font=smooth weight=light color=#2FB5A8 color2=#8EE3D9 back=#F0DFD2 thick=7 hot=92 hot_color=#E5484D
text  x=69 y=82 anchor=c size=3 font=smooth weight=medium color=#2FB5A8 text="GRAPHICS"
text  x=69 y=91 anchor=c w=19 size=3 font=smooth weight=regular color=#6B5E58 text="{gpu_temp}  ·  {gpu_power}"
ring  x=90 y=44 anchor=c w=16.4 h=68 value=ram text="{ram}" font=smooth weight=light color=#2B3A67 color2=#6F86C9 back=#F0DFD2 thick=7 hot=92 hot_color=#E5484D
text  x=90 y=82 anchor=c size=3 font=smooth weight=medium color=#2B3A67 text="MEMORY"
text  x=90 y=91 anchor=c w=19 size=3 font=smooth weight=regular color=#6B5E58 text="{ram_used} / {ram_total}"
