# ledger
rect  x=0 y=0 w=100 h=100 color=#0D1321 opacity=82
text  x=3 y=8 anchor=l size=7 font=smooth weight=light color=#F1EBDD text="{time_short}"
text  x=17 y=8 anchor=l size=3 font=smooth weight=regular color=#9AA3B8 text="{date}"
text  x=97 y=8 anchor=r w=30 size=4 font=smooth weight=light color=#D6D0C0 text="{weather_temp}   {weather_city}"
rect  x=3 y=17.5 w=94 h=0.3 color=#C8A96A opacity=100
text  x=3 y=25 anchor=tl size=3 font=smooth weight=medium color=#C8A96A text="CPU"
text  x=97 y=23.5 anchor=tr w=70 size=5 font=smooth weight=light color=#F1EBDD text="{cpu}   {cpu_temp}   {cpu_power}"
bar   x=3 y=34 w=94 h=1.6 value=cpu color=#C8A96A color2=#F7E7B4 flow=4 back=#1F2840
text  x=3 y=40 anchor=tl size=3 font=smooth weight=medium color=#C8A96A text="GPU"
text  x=97 y=38.5 anchor=tr w=70 size=5 font=smooth weight=light color=#F1EBDD text="{gpu}   {gpu_temp}   {gpu_power}"
bar   x=3 y=49 w=94 h=1.6 value=gpu color=#C8A96A color2=#F7E7B4 flow=4 back=#1F2840
text  x=3 y=55 anchor=tl size=3 font=smooth weight=medium color=#C8A96A text="MEMORY"
text  x=97 y=53.5 anchor=tr w=70 size=5 font=smooth weight=light color=#F1EBDD text="{ram}   {ram_used} / {ram_total}"
bar   x=3 y=64 w=94 h=1.6 value=ram color=#C8A96A color2=#F7E7B4 flow=4 back=#1F2840
text  x=3 y=70 anchor=tl size=3 font=smooth weight=medium color=#C8A96A text="NETWORK"
text  x=97 y=68.5 anchor=tr w=70 size=5 font=smooth weight=light color=#F1EBDD text="DN {net_down}   UP {net_up}"
rect  x=3 y=79.5 w=94 h=0.25 color=#1F2840 opacity=100
text  x=3 y=85 anchor=tl size=3 font=smooth weight=medium color=#C8A96A text="DISK"
text  x=97 y=83.5 anchor=tr w=70 size=5 font=smooth weight=light color=#F1EBDD text="R {disk_read}   W {disk_write}"
rect  x=3 y=94.5 w=94 h=0.25 color=#1F2840 opacity=100
