# radial (portrait)
rect  x=0 y=0 w=100 h=100 color=#070A12
spectrum x=50 y=17 anchor=c w=96 h=22 shape=circle style=bars bars=72 gap=35 inner=60 color=#00D4FF color2=#FF4FD8 flow=6
text  x=50 y=16 anchor=c size=9 font=smooth weight=light color=#FFFFFF text="{time_short}"
text  x=8 y=38 anchor=tl size=3 font=smooth weight=medium color=#7CE8FF text="PROCESSOR"
text  x=8 y=43 anchor=tl size=10 font=smooth weight=light color=#FFFFFF text="{cpu}"
text  x=8 y=50 anchor=tl size=3 font=smooth weight=regular color=#9AA8C8 text="{cpu_temp}  ·  {cpu_power}"
text  x=8 y=60 anchor=tl size=3 font=smooth weight=medium color=#FF9AE8 text="GRAPHICS"
text  x=8 y=65 anchor=tl size=10 font=smooth weight=light color=#FFFFFF text="{gpu}"
text  x=8 y=72 anchor=tl size=3 font=smooth weight=regular color=#9AA8C8 text="{gpu_temp}  ·  {gpu_power}"
text  x=8 y=82 anchor=tl size=3 font=smooth weight=medium color=#C8FF9A text="MEMORY"
text  x=8 y=87 anchor=tl size=10 font=smooth weight=light color=#FFFFFF text="{ram}"
text  x=50 y=97 anchor=b size=3 font=smooth weight=regular color=#9AA8C8 w=90 text="{song}"
