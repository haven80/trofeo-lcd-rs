# mineral — dark mineral cards, sage green, a ring and six small readings on each.
rect  x=0 y=0 w=100 h=100 color=#0E1012 opacity=70
rect  x=1 y=3 w=17 h=16 color=#1B1E21
text  x=2.4 y=11.5 anchor=l size=9 font=smooth weight=light color=#F3F5F4 text="{time_short}"
rect  x=19.5 y=3 w=22 h=16 color=#1B1E21
text  x=21 y=11.5 anchor=l size=8 font=smooth weight=light color=#F3F5F4 text="{weather_temp}"
text  x=31.5 y=11.5 anchor=l w=9.5 size=3 font=smooth weight=regular color=#8C9490 text="{weather_city}"
rect  x=43 y=3 w=56 h=16 color=#1B1E21
text  x=44.5 y=6.5 size=2 font=smooth weight=medium color=#A9CDB8 text="NOW PLAYING"
text  x=44.5 y=11 w=52 size=5 font=smooth weight=regular color=#F3F5F4 text="{song}"
rect  x=1 y=22 w=32.3 h=75 color=#1B1E21
text  x=2.5 y=25.5 anchor=l size=3 font=smooth weight=medium color=#A9CDB8 text="CPU"
text  x=2.5 y=44 anchor=l size=17 font=smooth weight=light color=#F3F5F4 text="{cpu_temp}"
ring  x=27 y=44 w=9.5 h=40 anchor=c value=cpu text="{cpu}" font=smooth weight=light color=#A9CDB8 back=#2E3336 thick=9 hot=90 hot_color=#E58A7B
text  x=2.5 y=62 size=2 font=smooth weight=medium color=#8C9490 text="POWER"
text  x=2.5 y=66.6 w=9.6 size=5 font=smooth weight=regular color=#F3F5F4 text="{cpu_power}"
text  x=12.9 y=62 size=2 font=smooth weight=medium color=#8C9490 text="CLOCK"
text  x=12.9 y=66.6 w=9.6 size=5 font=smooth weight=regular color=#F3F5F4 text="{cpu_freq}"
text  x=23.3 y=62 size=2 font=smooth weight=medium color=#8C9490 text="FPS"
text  x=23.3 y=66.6 w=9.6 size=5 font=smooth weight=regular color=#F3F5F4 text="{fps}"
