text  x=27 y=29 anchor=tl size=3 font=smooth weight=medium color=#FFB000 text="GRAPHICS"
text  x=27 y=52 anchor=l w=21 size=11 font=smooth weight=light color=#F4F4F5 text="{gpu_temp}"
bar   x=27 y=68 w=21.5 h=1.6 value=gpu color=#FFB000 color2=#FF4D00 flow=3 back=#23252A
text  x=27 y=74 anchor=tl w=10 size=4 font=smooth weight=regular color=#C9CBCF text="{gpu}"
text  x=38 y=74 anchor=tl w=10 size=4 font=smooth weight=regular color=#C9CBCF text="{gpu_power}"
text  x=27 y=86 anchor=tl w=21 size=4 font=smooth weight=regular color=#8B8F96 text="{fps} FPS"
rect  x=51 y=25 w=21.5 h=0.4 color=#FFB000 opacity=100
text  x=51 y=29 anchor=tl size=3 font=smooth weight=medium color=#FFB000 text="MEMORY"
text  x=51 y=52 anchor=l w=21 size=11 font=smooth weight=light color=#F4F4F5 text="{ram}"
