text  x=51 y=74 anchor=tl w=10 size=4 font=smooth weight=regular color=#C9CBCF text="{ram_used}"
text  x=62 y=74 anchor=tl w=10 size=4 font=smooth weight=regular color=#C9CBCF text="{ram_free}"
text  x=51 y=86 anchor=tl w=21 size=4 font=smooth weight=regular color=#8B8F96 text="{ram_total}"
rect  x=75 y=25 w=21.5 h=0.4 color=#FFB000 opacity=100
text  x=75 y=29 anchor=tl size=3 font=smooth weight=medium color=#FFB000 text="NETWORK"
text  x=75 y=52 anchor=l w=21 size=9 font=smooth weight=light color=#F4F4F5 text="{net_down}"
