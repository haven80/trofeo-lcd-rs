# pihole — a big ring with the share of blocked queries, the figures in a list.
rect  x=0 y=0 w=100 h=100 color=#0B0E14 opacity=78
ring  x=15 y=50 w=25 h=88 anchor=c value=pihole_percent text="{pihole_percent}" font=smooth weight=light color=#FF4D5E color2=#FF9A3D back=#232A36 thick=13
text  x=15 y=70 anchor=c size=3 font=smooth weight=medium color=#8A93A3 text="BLOCKED"
text  x=33 y=10 size=4 font=smooth weight=medium color=#FF4D5E text="PI-HOLE"
text  x=97 y=10 anchor=tr size=3 font=smooth weight=medium color=#8A93A3 text="{pihole_status}   {time_short}"
rect  x=33 y=21 w=64 h=0.25 color=#2A3140
text  x=33 y=27 size=3 font=smooth weight=medium color=#4DA3FF text="QUERIES"
text  x=33 y=44 anchor=l size=12 font=smooth weight=light color=#F2F5FA text="{pihole_queries}"
text  x=57 y=27 size=3 font=smooth weight=medium color=#FF4D5E text="BLOCKED"
text  x=57 y=44 anchor=l size=12 font=smooth weight=light color=#F2F5FA text="{pihole_blocked}"
text  x=80 y=27 size=3 font=smooth weight=medium color=#FFC845 text="ON LISTS"
text  x=80 y=44 anchor=l size=12 font=smooth weight=light color=#F2F5FA text="{pihole_domains}"
rect  x=33 y=60 w=64 h=0.25 color=#2A3140
text  x=33 y=68 size=3 font=smooth weight=medium color=#8A93A3 text="ALLOWED {pihole_allowed}    CACHED {pihole_cached}    FORWARDED {pihole_forwarded}"
text  x=33 y=80 size=3 font=smooth weight=medium color=#8A93A3 text="CLIENTS {pihole_clients}"
bar   x=33 y=90 w=64 h=3 value=pihole_percent color=#FF4D5E color2=#FF9A3D back=#232A36
