# Copy this file as "trofeo.conf" next to the executable
# (or in the folder you launch it from), or use --config <file>.
# Priority: defaults < this file < command-line arguments.
# Full reference (every option, with examples): see OPTIONS_GUIDE.md

# --- Orientation ------------------------------------------------------------
# landscape = horizontal display (1920x462, default)
# portrait  = display mounted vertically (462x1920 canvas, rotated for the panel)
orientation = landscape

# true = an extra 180° rotation (if the image comes out upside down)
flip = false

# --- Trofeo Vision 6.86 and the other 0416:5302 screens ----------------------------
# These screens are recognised by themselves (the size comes from the handshake). If the picture
# comes out turned or partial, use the screen test: in trofeo_config (Screen section) press
# "Start the screen test" and click the number of the upright picture, or run
#   trofeo_lcd --lcd-test
# which asks for the number and writes these values for you.
# hid_mount = auto        # auto | 0 | 90 | 180 | 270: turns the picture for the way the panel is mounted
# hid_header = raster     # raster | panel: size written in the frame header (JPEG screens)
# hid_rgb565 = auto       # auto | little | big: pixel byte order of the small 320x240 screens (RGB565)

# --- Margins (pixels) --------------------------------------------------------
# Pulls the interface away from the screen edges. "margin" applies to all sides,
# then you can override a single side. To "lower" the image: margin_top.
# margin = 0
margin_top = 30
# margin_bottom = 0
# margin_left = 0
# margin_right = 0

# --- Language -----------------------------------------------------------------
# en | it | de | es | fr | pt
language = en

# --- Background ----------------------------------------------------------------
# Image (jpg, png, bmp), animated GIF, or video (mp4, mkv, webm, avi, mov...).
# Videos require ffmpeg: ffmpeg.exe next to the program, on the PATH, or its
# path given with "ffmpeg = ...".
# background = C:\Pictures\background.jpg
# background_dim = 40     # 0-100: darkens the background for better text readability
# ffmpeg = C:\ffmpeg\bin\ffmpeg.exe

# --- Background: fit and position -------------------------------------------
# background_fit: cover    = fills everything keeping the aspect ratio (default, crops)
#                 stretch  = fills everything, distorting the image
#                 contain  = whole image visible, with dark bars
#                 original = original size, no scaling
# background_fit = cover
# background_position = center      # see the position list below
# background_offset_x = 0           # shifts the image: + right, - left
# background_offset_y = 0           # + down, - up

# --- What to show -------------------------------------------------------------
# Items: cpu, gpu, uptime, time, date, mem, net, disk, volume, nowplaying, weather,
#        spectrum (audio spectrum), clock (big clock),
#        clock_date (date under the big clock), dashboard (FPS/GPU/CPU/RAM while gaming)
# "show" = show ONLY these. "hide" = hide these (everything else stays).
# hide = clock_date, disk
# show = cpu, gpu, mem, nowplaying, clock, spectrum
#
# Hiding the audio spectrum: with hide = spectrum, the big clock stays visible
# during playback (if you don't hide it too) and the fps stays low.
# hide = spectrum
#
# Decimals in the CPU/GPU/RAM percentages: 0 = "37%" (default), 1 = "37.4%"
# percent_decimals = 0

# --- Font ---------------------------------------------------------------------------
# The font of ALL the text (status lines, big clock, layouts, music screen, ticker...):
# pixel = the blocky 5x7 font (default); smooth = anti-aliased Poppins, with lower case,
# accents and the degree sign. The tiles layout has its own tiles_font.
# font = pixel
# font_weight = auto           # smooth only: auto (by size) | light | regular | medium

# --- Colors (#RRGGBB, R,G,B, or a name: red, green, blue, yellow, white...)
# color = green              # spectrum bars (default: green->red gradient)
# text_color = #FFFFFF       # info block and dashboard text
# clock_color = #00C8FF      # big clock

# --- Positions -----------------------------------------------------------------
# top-left  top  top-right | center-left  center  center-right | bottom-left  bottom  bottom-right
# status_position = top-left     # info block (CPU, RAM, track...)
# clock_position = center        # big clock
# spectrum_position = center     # spectrum
# spectrum_width = 100           # % of the available area
# spectrum_height = 100
# status_style = auto            # auto | lines (3 long lines) | list (vertical list)

# --- Audio detection (EQ bars) ----------------------------------------------
# "Silence" is decided by comparing the loudest sample in each window against
# silence_threshold: below it, no music is considered to be playing (EQ bars
# stay down, FPS drops to idle). This reflects the actual system/app volume
# (loopback capture), so quiet listening levels can fall under the default
# and look like silence — lower it if the bars don't react at low volume.
# silence_threshold = 0.005     # 0.0-1.0 peak amplitude (lower = more sensitive)
# silence_timeout_ms = 800      # how long it must stay quiet before dropping to idle-fps

# --- Ticker (news headlines, or any custom feed) -----------------------------
# One or more sources, comma-separated. Each source can be:
#  - an RSS/Atom feed URL: headlines are taken from each item's title
#  - any other http(s):// URL: each non-empty line of the response is used
#    as one item (plug in a script/webhook/plain-text endpoint)
#  - a local file path: each non-empty line (not starting with '#') is one
#    item, re-read on every refresh
# ticker_source = https://www.ansa.it/sito/ansait_rss.xml
# ticker_source = https://example.com/feed.xml, C:\ticker\my_notes.txt
# ticker_refresh_min = 10      # how often to re-fetch, in minutes (1-1440)
#
# Two independent ways to show it:
#  - a scrolling line (a "chyron") drawn on top of whatever else is on
#    screen: show/hide = ticker (like any other item), position/style below
#  - a dedicated full panel: layout = news  (or layout = default, news)
# ticker_position = bottom      # top-left, top, top-right, center-left, center,
#                                # center-right, bottom-left, bottom, bottom-right
# ticker_size = 3                # 1-30
# ticker_color = #FFC800
# ticker_backdrop = true         # a panel behind the ticker line (default: text_backdrop)
# ticker_width = 100             # % of the canvas the ticker line can use

# --- New version notice ----------------------------------------------------------
# Off by default. When on, the program looks on GitHub at start-up (one small request, nothing about
# your computer is sent, nothing is downloaded) and, if a newer version exists, shows a banner at the
# bottom of the screen for a few seconds. These three need a restart. "trofeo_lcd --update-demo"
# shows the banner right away with a made-up version, to see how it looks.
# update_check = false
# update_notice_secs = 8         # how long the banner stays (2-120)
# update_check_hours = 0         # check again every N hours; 0 = only at start-up (max 720)

# --- Brightness ------------------------------------------------------------
# 0-100 (100 = unchanged). The panel has no known brightness command:
# the image is darkened in software before being sent.
# brightness = 100

# --- DeepCool ----------------------------------------------------------------
# false = the program does NOT touch the case's DeepCool display (stays off).
# deepcool = false
# CH170 / CH270 / CH690 DIGITAL case display: what the big field shows (changes live).
# fan = the fan speed in RPM, read from LibreHardwareMonitor (see "Fans" below).
# The display has a CPU and a GPU section (temperature, power, usage, clock):
# deepcool_source = cpu          # cpu (default) | gpu | alternate = CPU and GPU in turn
# deepcool_mode = alternate      # freq (default) | fan | alternate = frequency and RPM in turn
# deepcool_fan = cpu             # cpu | case | pump | gpu | both (= CPU fan and case fans in turn)
# deepcool_alternate = 6         # seconds before it switches (2-120), also between CPU and GPU

# --- In-game FPS -------------------------------------------------------------
# Measures the FPS of any DirectX 9-12 game (NVIDIA/AMD/Intel) via ETW.
# Requires starting the program AS ADMINISTRATOR.
# fps_monitor = true

# --- Preset layouts ----------------------------------------------------------
# Big panels instead of the clock. List: trofeo_lcd.exe --layout list
#   cpu-gpu       CPU and GPU side by side (big usage, temperature and watts below)
#   temps         CPU and GPU temperatures in big, with a bar
#   overview      CPU, GPU, RAM and clock
#   grid6         3x2 grid: CPU/GPU usage and temperature, RAM, clock
#   clock-center  clock in the center, CPU on the left and GPU on the right
#   io            network, disk and RAM
#   music         current track in big + clock
#   gaming        FPS, GPU, GPU and CPU temperature
#   cpu           CPU only, big
#   gpu           GPU only, big
#   tiles         rounded glass tiles (see the "Tiles" block below)
#   deck          instrument columns: a gauge, a big value, a graph, four readings (see "Deck, Cards and Orbit")
#   cards         colourful cards in a mosaic, each with a ghost graph (see "Deck, Cards and Orbit")
#   orbit         concentric rings per device with the readings beside them (see "Deck, Cards and Orbit")
#   frame         digital picture frame: a collage of a folder's pictures (see below)
#   weather       Current weather, big: temperature, condition icon and city
#   news          Latest headlines from ticker_source, scrolling
# With a layout, the top info block and the spectrum are off (the panels already
# show the data); "show = nowplaying, time" adds info lines, "hide" removes them.
# The automatic dashboard while gaming stays on (hide = dashboard to disable it).
# layout = cpu-gpu
# Rotation: several layouts separated by commas, changing every layout_interval seconds.
# layout = cpu-gpu, temps, music
# Each entry can set its OWN duration with "name:seconds", instead of sharing
# layout_interval equally: the standard screen stays up for 30s, then weather
# shows for just 5s, then it goes back to 30s of the standard screen, and so on
# (not alternating every 5s — each entry gets its own full duration in turn):
# layout = default:30, weather:5
# An entry with no ":seconds" falls back to layout_interval.
# "default" = the standard screen (status at the top, spectrum, big clock):
# layout = default, cpu-gpu, temps     # also rotates with the standard screen
# "default2" = same as default but with per-item styling (<item>_size/_position/_color,
# see below). Per-item options only apply to default2; default stays classic.
# layout = default, default2            # alternate between the classic and custom screen
# If you set per-item options without writing "layout", default2 is used.
# layout_interval = 15       # default seconds per layout when an entry has no ":seconds" (2-3600)
# layout_spectrum = false    # true = show the spectrum while music is playing
# layout_hold_on_music = false  # true = while music plays, stay on the FIRST layout of the
#                               # list (no rotation); rotation restarts when the music stops

# --- Tiles (layout = tiles) -----------------------------------------------------
# Which tiles: clock cpu cpu_temp cpu_watt gpu gpu_temp gpu_hotspot gpu_watt ram net disk fps weather music
#   and, with LibreHardwareMonitor (see "Fans" below): cpu_fan case_fan pump gpu_fan fans mb_temp disk_temp
# ("," between tiles, "|" between rows, ":ring" = a ring, "clock:tall" = as tall as all rows).
# layout = tiles
# tiles = clock:tall, cpu_temp, gpu_temp | ram:ring, cpu:ring, gpu:ring
# tiles_font = smooth                 # smooth | pixel
# tiles_theme = dark                  # dark | light
# tiles_bar_color = #00C8FF, #FF0080  # bars and rings: auto | a color | a gradient
# tiles_bg = gradient                 # global | color | gradient | effect | image
# tiles_bg_color = #1B2A4A, #4A1B3A
# A color of its own for every tile, from the color presets of the animated background;
# several presets fade into each other, tile by tile (empty = one color for all):
# tiles_palette = pastel, ocean, sunset   # also: all, custom (with tiles_colors)
# tiles_palette_interval = 20             # seconds per preset (5-3600)
# tiles_palette_stagger = 50              # 0 = tiles change together ... 100 = spread out
# tiles_colors = #FF0080, #00C8FF         # your own colors, for "custom"
# tiles_rpm = true                        # a "CPU 1240 / CASE 780 RPM" line on the CPU tiles
# tiles_fan_max = 2500                    # RPM that fills the bar of a fan tile

# --- Fans and sensors: LibreHardwareMonitor ------------------------------------------
# Intel CPUs: the built-in CPU sensor reads AMD Ryzen only, so on Windows the CPU temperature and power of an
# Intel CPU come from LibreHardwareMonitor too (start it as administrator, Options > Remote Web Server > Run).
# "trofeo_lcd --diag" shows which CPU sensor the program found ("none" on Intel). See README: "Which sensors you need".
# Fan speeds (and the motherboard / disk temperature) come from LibreHardwareMonitor:
# start it AS ADMINISTRATOR, then Options > Remote Web Server > Run (port 8085) and leave it open.
# Nothing happens when it is not running. "trofeo_lcd --lhm-list" shows what it reports and which
# sensor is used for what. Fans show up in the tiles (cpu_fan, case_fan, pump, gpu_fan, fans,
# mb_temp, disk_temp), in the CPU tiles (tiles_rpm), in the status line (below), in the
# deck / cards / orbit screens and on the DeepCool case display (deepcool_mode = fan).
# lhm = true                     # false = do not look for LibreHardwareMonitor
# lhm_url = http://127.0.0.1:8085
# lhm_interval = 2               # seconds between readings (1-60)
# The automatic choice picks the sensors by their names; to point a role at another sensor write
# a part of its name (in quotes, a # is allowed inside quotes):
# lhm_cpu_fan = "Fan #2"
# lhm_case_fan = chassis
# lhm_pump = AIO
# lhm_mb_temp = VRM
# In the status line: hide = cpu_fan, case_fan, pump removes the fan speeds from the CPU line.

# --- Deck, Cards and Orbit (layout = deck | cards | orbit) ------------------------------
# Three more full screens, from the same readings as the tiles. Panels: cpu gpu ram fans net disk
# clock weather music (the clock panel also shows the weather and the track).
# layout = deck
# deck = cpu, gpu, ram, clock           # instrument columns (2-5)
# deck_gauge = true                     # the gauge line on top of each column
# layout = cards
# cards = clock | cpu | gpu | ram, disk | music, net   # "|" = next column, "," = stacked in the column
# cards_radius = 26                     # corner radius (0-60), default by size
# cards_gap = 12                        # pixels between the cards (0-40)
# layout = orbit
# orbit = cpu, gpu, ram                 # a cluster of concentric rings per device (1-4)
# orbit_clock = true                    # the clock block on the right
# orbit_legend = true                   # the names of the rings under each cluster
# For all three:
# dash_palette = default                # accent colours: default or a preset of the animated backgrounds
# dash_colors = #A76BFF, #38C6F4, #FF6FB1   # or your own colours (used instead of the preset)
# dash_hero = temp                      # the big number of CPU and GPU: temp (default) | load
# dash_font = smooth                    # smooth | pixel
# dash_theme = light                    # dark (default) | light = white plate, dark text, pastel cards
# dash_text_color = #FFFFFF             # empty = by theme
# dash_plate_color = #FFFFFF            # the panel behind deck and orbit (empty = by theme)
# dash_plate = 50                       # its opacity, 0-100 (50 dark / 92 light); lower it to see an animated
#                                       # background through it, 0 = no plate
# cards_fan = true                      # fan RPM at the top right of the CPU and GPU cards (LibreHardwareMonitor)
# cards_opacity = 100                   # opacity of the cards, 0-100; lower it to see the background
# dash_graph = true                     # the graph of the last minutes
# dash_history = 90                     # seconds of history in the graphs (20-600)
# dash_net_max = 25                     # network MB/s that fills a ring / gauge
# dash_bg = gradient                    # global | color | gradient | effect | image
# dash_bg_color = #10142A, #241030
# dash_bg_image = C:\Users\Me\Pictures\back.jpg
# dash_bg_dim = 30
# The maxima of watts, FPS and fan speed come from the Tiles block (tiles_cpu_watt_max, ...).

# --- Digital frame (layout = frame) ------------------------------------------------
# A collage of the pictures of a folder, with glass tiles (the look of "tiles") at the sides.
# layout = frame
# frame_folder = C:\Users\Me\Pictures\Holidays   # JPG, PNG, WebP, BMP, GIF (not HEIC)
# frame_style = mosaic          # mosaic = tidy collage | polaroid = scattered prints with a white border
# frame_photos = 5              # pictures on screen at once (1-9)
# frame_interval = 8            # seconds between changes: ONE picture is replaced each time (2-3600)
# frame_order = shuffle         # shuffle | name
# frame_transition = fade       # fade | slide (a wipe in the mosaic, a print dropping in with polaroid)
# frame_recursive = false       # true = include the subfolders
# frame_refresh = 60            # look at the folder again every N seconds (5-3600)
# frame_bg = blur               # blur (the current picture, blurred) | dark | global (the normal background)
# frame_dim = 60                # how dark the blurred background is (0-100)
# frame_gap = 10                # mosaic: pixels between the pictures (0-40)
# frame_radius = 14             # mosaic: corner radius (0-60)
# frame_left = clock, ram:ring  # tiles of the left column (top strip when portrait); "none" = no tiles
# frame_right = cpu:ring, gpu:ring
# frame_side_width = 17         # width of a side in % of the long side (8-35)

# --- Music screen ----------------------------------------------------------------
# true = while a track plays, show a now-playing card: album cover on the left (with a
# glow), artist / title / album, a progress bar with times, and the spectrum on the side.
# Colors come from the cover. It replaces the status lines while it is shown.
# music_screen = false
# Background behind the card:
#   gradient = the cover's dominant color fading to near-black (default, Spotify-like)
#   blur     = the cover itself, blurred      color = one flat color from the cover
#   solid    = one flat color of your choice  none  = keep what is behind (your background)
#   effect   = the animated background effect (see the section below)
# music_bg = gradient
# music_bg_brightness = 40   # 0-100: how strong the cover color is (gradient/blur/color)
# music_bg_blur = 70         # 0-100: blur amount (blur only)
# music_bg_fit = center      # center = centred slice, stretch = whole cover squeezed (blur only)
# music_bg_color = #121218   # the color for music_bg = solid
# music_progress = true    # progress bar and times (only if the player reports them)
# Small system info line at the very bottom: cpu, gpu, ram, net, disk, time, uptime
# (in the order given), all, or none to turn it off.
# music_stats = cpu, gpu, ram
# Spectrum color on this screen only (the main screen keeps its own spectrum_palette):
#   cover = taken from the album cover (default)     main = same as the main screen
#   #1DB954 = one fixed color    #FF0080, #00FFFF = gradient    fire, ocean = presets (rotate)
# music_spectrum_color = cover

# --- Solid background color ----------------------------------------------------------
# A flat color behind everything instead of a picture: a name (black, white, gray, red,
# green, blue, yellow, orange, pink, purple, teal, navy, gold, ... also nero, bianco,
# rosa, verde ...), a hex code or R,G,B. An image or effect, if set, wins.
# background_color = black
# background_color = #0B1D3A

# --- Animated background effect ----------------------------------------------------
# A soft animated background instead of a picture: colors that blend and drift.
# Very light on the CPU (the picture is calculated on a coarse grid and stretched).
# It replaces "background" while it is on, and works with margins and panel_opacity.
# background_effect = plasma   # plasma | aurora | lava | waves | matrix | rain | aquarium | network | globe | none
#   matrix = minimal digital rain (characters), rain = thin streaks; green by default
#   aquarium = side view of an aquarium: moving water surface, light rays, caustics, bubbles
#   network = nodes drifting about, joined by thin lines (no text, only lines and dots)
#   globe = a slowly turning sphere of nodes and lines
# effect_level = 50            # aquarium: how high the water reaches; network / globe: how many nodes (0-100)
# effect_theme = dark          # dark | light: matrix / rain / aquarium / network / globe on a white background
#                              # (use a dark text_color / clock_color with light)
# Colors: pastel | fluo | neon | candy | sunset | ocean | aurora | fire | forest | ice |
# mono | rainbow | custom; for matrix / rain: matrix (green) | amber | violet | crimson | snow;
# for aquarium: lagoon (default) | deep | tropical; network / globe use ice unless you choose
# (a one-colour palette such as crimson gives grey lines with red nodes).
# Several (comma-separated) or "all" rotate with a cross-fade.
# effect_palette = neon
# Your own colors (2+); used directly when effect_palette is not set, or add "custom"
# to the list above:
# effect_colors = #FF0080, #00FFFF, #FFD000
# effect_palette_interval = 60  # 5-3600 s between palettes when several are listed
# effect_speed = 30             # 0 (frozen) - 100 (fast)
# effect_scale = 100            # 25-400 %: size of the shapes
# effect_brightness = 40        # 0-100: lower = easier to read the text on top
#                               # (pastel / candy look best at 70-85 with a dark text_color)
# effect_fps = 8                # 1-30 frames per second while it moves (lower = lighter)
# On the music screen use: music_bg = effect (brightness = music_bg_brightness).

# --- Pixel game --------------------------------------------------------------------
# A little self-playing pixel-art platformer under the clock (default screen and
# "default2"): a knight or a cat runs and jumps over obstacles. The CPU load sets its
# speed, music makes it hop, network / disk bursts drop coins / a chest, the hour brings
# fireworks, and the sky follows the real time of day and the weather.
# While it is shown the idle screen runs at --active-fps (smooth animation).
# pixel_game = true
# pixel_game_hero = both      # knight | cat | both (they take turns every 5 minutes)
# pixel_game_height = 46      # 20-70: % of the free area taken by the game strip
# pixel_game_hud = true       # coin counter in the corner

# --- Spectrum styles & colors ---------------------------------------------------
# Style: bars (classic) | led | peaks | area | mirror. Several, comma-separated, or "all"
# rotate every spectrum_style_interval seconds.
# spectrum_style = bars
# spectrum_style_interval = 30
# Color palette: default | rainbow | fire | ocean | sunset | neon | ice | matrix | purple |
# custom. Several, comma-separated, or "all" rotate (with a cross-fade) every
# spectrum_palette_interval seconds. Unset = use "color" as before.
# spectrum_palette = fire, ocean, neon
# spectrum_palette_interval = 20
# Your own gradient (2+ colors, quiet -> loud). On its own it is used directly;
# add "custom" to a palette list to rotate it with the presets.
# spectrum_gradient = #FF0080, #00FFFF
# Hue scroll speed of the "rainbow" palette, degrees per second (0 = static).
# spectrum_rainbow_speed = 30

# --- Panel transparency -------------------------------------------------------
# Background opacity of the panels (layouts and the in-game dashboard): 100 = solid,
# 0 = transparent (only the border remains), so more of the background shows through.
# panel_opacity = 60
# A panel behind the status lines and the big clock (default screen), to make them
# easier to read over a background. Uses the same opacity as panel_opacity.
# text_backdrop = true

# --- Weather --------------------------------------------------------------------
# Current temperature + condition icon (Open-Meteo, no API key needed). By default
# the location is auto-detected from the machine's public IP address; set a city
# name to override it (requires a restart, like deepcool/fps_monitor/screenshot_key):
# weather_city = Milano
# weather_unit = c        # c (default) or f
# Show it as a per-item line (see below, item name "weather") in default2, and/or
# as its own big panel:
# layout = weather              # weather panel alone
# layout = default, weather     # rotates with the standard screen

# --- Per-item control: size, position, color ----------------------------------
# Items: cpu, gpu, uptime, time, date, mem (or ram), net, disk, volume, nowplaying,
#        weather
# Just set ONE of these options and the items become independent (each on its
# own line, with its own size; items sharing the same position stack up).
#   <item>_size      = 1..30   (default 3; 1 = tiny, 6 = big)
#   <item>_position  = top-left, top, top-right, center-left, center, center-right,
#                      bottom-left, bottom, bottom-right  (default: status_position)
#   <item>_color     = the item's color (name or #RRGGBB)
#   <item>_backdrop  = true/false  a panel behind that item (default: text_backdrop)
# cpu_size = 5
# cpu_color = #FFC800
# cpu_position = top-left
# ram_size = 2
# ram_position = bottom-left
# gpu_size = 4
# gpu_position = top-right
# nowplaying_size = 3
# nowplaying_position = bottom
# The track scrolls without overlapping nearby items on the same row; you can
# also limit its width:
# nowplaying_label = false   # removes the "NOW PLAYING:" label and leaves just the title
# nowplaying_width = 40      # % of the screen taken up by the track (avoids covering other items)
# Turning individual items on/off: show = ... / hide = ... (see above). You can
# also hide the details inside the CPU and GPU lines:
#   hide = cpu_freq, cpu_temp, cpu_power, gpu_temp, gpu_hotspot, gpu_power, gpu_fan, gpu_clock, gpu_fps, cpu_fan, case_fan, pump
# The GPU hot spot (junction) in the GPU line is off by default:  show = gpu_hotspot
# Units: network in KB/S (default), MB/S, or auto (KB below 1 MB/S, then MB); RAM in MB or GB
# net_unit = mb
# mem_unit = gb
# Big clock (default screen): size of the time and date
# clock_backdrop = true         # a panel behind the big clock
# clock_time_size = 20        # 1..60
# clock_date_size = 6

# The file is re-read every second: saved changes apply immediately, without
# restarting (orientation, margins, background, language, colors, layouts, brightness, etc.).
# If the file has an error, the previous configuration stays valid and the reason is
# written to trofeo-errors.txt (next to trofeo_lcd.exe).
# Only deepcool, fps_monitor, openrgb, hide_console, screenshot_key, weather_city,
# ticker_source and ticker_refresh_min require a restart. weather_unit, the "weather"
# show/hide/size/position/color/backdrop options, and ticker_position/ticker_size/
# ticker_color/ticker_backdrop/ticker_width all apply live, like everything else.
